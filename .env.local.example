# ---- Core (required for Module 1 & 2) ----
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- LLM provider ----
# Which model powers AI generation: gemini (free, default) | anthropic | groq
LLM_PROVIDER=gemini
# Gemini (free): get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash   # optional override
# Anthropic (paid) — only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Groq (free) — only needed if LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Auth allowlist — comma-separated emails permitted to sign in (magic link).
# If unset, ANY authenticated email is allowed — always set this in production.
ALLOWED_EMAILS=rutvij.karkhanis@gmail.com

# ---- Outreach automation (Module 3) — NOT YET WIRED, ask before enabling ----
# n8n
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# Unipile (LinkedIn DMs / connection requests)
UNIPILE_API_KEY=
UNIPILE_DSN=
# Gmail OAuth (cold email sequences)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Twilio (WhatsApp Business)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ---- Job discovery (free) — powers the /discover page ----
# Provider priority: Careerjet → Jooble → Adzuna (first one configured wins).
#
# Careerjet (RECOMMENDED for UAE) — targets Dubai via locale en_AE.
# Free affiliate id: https://partners.careerjet.com
CAREERJET_AFFID=
# CAREERJET_LOCALE=en_AE
#
# Jooble — keys are REGION-LOCKED to the site you register on. For UAE jobs use
# a key from ae.jooble.org AND set JOOBLE_HOST=ae.jooble.org. Free: jooble.org/api/about
JOOBLE_API_KEY=
# JOOBLE_HOST=ae.jooble.org
#
# Adzuna — does NOT cover UAE (only at au be br ca ch de es fr gb in it mx nl nz
# pl sg us za). Free key: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Company intelligence (Module 6) — NOT YET WIRED, ask before enabling ----
# Apollo.io (company enrichment)
APOLLO_API_KEY=
